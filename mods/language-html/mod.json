{
  "apiVersion": 1,
  "id": "language-html",
  "name": "HTML: структура и дубли разметки",
  "version": "1.1.0",
  "description": "HTML5-дерево, CSS-селекторы, ссылки и точные дубли исходной разметки. Pure Python; скрипты и сборка проекта не исполняются.",
  "autoActivate": {
    "extensions": [
      ".html",
      ".htm"
    ]
  },
  "analysis": {
    "apiVersion": 1,
    "projectRules": [
      {
        "id": "html-projects",
        "language": "html",
        "extensions": [
          ".html",
          ".htm"
        ],
        "manifestNames": [
          "package.json"
        ],
        "sourceRootMarkers": [
          "src"
        ],
        "logicalFolders": true
      }
    ],
    "markupProviders": [
      {
        "id": "html",
        "language": "html",
        "strategy": "html-structure-v1"
      }
    ]
  },
  "wiki": {
    "section": "Explore-Code",
    "pages": [
      {
        "id": "overview",
        "title": "HTML: структура проекта",
        "path": "wiki/Overview.md"
      }
    ]
  }
}
