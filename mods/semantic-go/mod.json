{
  "apiVersion": 1,
  "id": "semantic-go",
  "name": "Optional Go semantic bindings",
  "version": "1.0.0",
  "description": "Use existing gopls and Go context offline; unavailable tools preserve baseline maps.",
  "autoActivate": {
    "extensions": [
      ".go"
    ],
    "manifestNames": []
  },
  "analysis": {
    "apiVersion": 1,
    "semanticProviders": [
      {
        "id": "gopls",
        "language": "go",
        "strategy": "gopls-local-v1",
        "capabilities": [
          "definition",
          "calls"
        ]
      }
    ]
  },
  "wiki": {
    "section": "Agents-and-MCP",
    "pages": [
      {
        "id": "overview",
        "title": "Go: локальные привязки gopls",
        "path": "wiki/Overview.md"
      }
    ]
  }
}
