{
  "apiVersion": 1,
  "id": "semantic-rust",
  "name": "Rust semantic analysis",
  "version": "1.0.0",
  "description": "Optional installed rust-analyzer with existing static rust-project.json; no Cargo/build scripts/proc macros.",
  "autoActivate": {
    "extensions": [
      ".rs"
    ],
    "manifestNames": []
  },
  "analysis": {
    "apiVersion": 1,
    "semanticProviders": [
      {
        "id": "rust",
        "language": "rust",
        "strategy": "rust-analyzer-local-v1",
        "capabilities": [
          "definition",
          "calls"
        ]
      }
    ]
  },
  "wiki": {
    "section": "Agents-and-MCP",
    "pages": [
      {
        "id": "overview",
        "title": "Rust: локальные привязки rust-analyzer",
        "path": "wiki/Overview.md"
      }
    ]
  }
}
