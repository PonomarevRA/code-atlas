{
  "apiVersion": 1,
  "id": "language-kotlin",
  "name": "kotlin project structure",
  "version": "1.0.0",
  "description": "Declarative build-marker discovery. Logical folders are navigation areas, not claimed build modules.",
  "analysis": {
    "apiVersion": 1,
    "projectRules": [
      {
        "id": "kotlin-projects",
        "language": "kotlin",
        "extensions": [
          ".kt",
          ".kts"
        ],
        "manifestNames": [
          "pom.xml"
        ],
        "manifestSuffixes": [],
        "sourceRootMarkers": [
          "src/main/kotlin",
          "src/test/kotlin"
        ],
        "logicalFolders": false
      }
    ]
  },
  "wiki": {
    "section": "Explore-Code",
