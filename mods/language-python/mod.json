{
  "apiVersion": 1,
  "id": "language-python",
  "name": "python project structure",
  "version": "1.1.0",
  "description": "Declarative build-marker discovery. Logical folders are navigation areas, not claimed build modules.",
  "analysis": {
    "apiVersion": 1,
    "projectRules": [
      {
        "id": "python-projects",
        "language": "python",
        "extensions": [
          ".py"
        ],
        "manifestNames": [
          "pyproject.toml",
          "setup.py",
          "setup.cfg"
        ],
        "manifestSuffixes": [],
        "sourceRootMarkers": [
          "src"
        ],
        "logicalFolders": true
      }
    ]
  },
  "wiki": {
    "section": "Explore-Code",
    "pages": [
      {
        "id": "overview",
        "title": "Python: структура проекта",
        "path": "wiki/Overview.md"
      }
    ]
  }
}
