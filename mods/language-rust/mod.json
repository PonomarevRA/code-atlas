{
  "apiVersion": 1,
  "id": "language-rust",
  "name": "rust project structure",
  "version": "1.0.0",
  "description": "Declarative build-marker discovery. Logical folders are navigation areas, not claimed build modules.",
  "analysis": {
    "apiVersion": 1,
    "projectRules": [
      {
        "id": "rust-projects",
        "language": "rust",
        "extensions": [
          ".rs"
        ],
        "manifestNames": [
          "Cargo.toml"
        ],
        "manifestSuffixes": [],
        "sourceRootMarkers": [
          "src"
        ],
        "logicalFolders": false
      }
    ]
  },
  "wiki": {
    "section": "Explore-Code",
    "pages": [
      {
        "id": "overview",
        "title": "Rust: структура проекта",
        "path": "wiki/Overview.md"
      }
    ]
  }
}
