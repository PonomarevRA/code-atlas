{
  "apiVersion": 1,
  "id": "semantic-php",
  "name": "PHP local semantic candidates",
  "version": "1.0.0",
  "description": "Optional existing Phpactor/PHP source bindings; captured fragments remain candidates, no Composer bootstrap or engine installation.",
  "autoActivate": {
    "extensions": [
      ".php"
    ],
    "manifestNames": []
  },
  "analysis": {
    "apiVersion": 1,
    "semanticProviders": [
      {
        "id": "phpactor",
        "language": "php",
        "strategy": "phpactor-local-v1"
      }
    ]
  },
  "wiki": {
    "section": "Agents-and-MCP",
    "pages": [
      {
        "id": "overview",
        "title": "PHP: локальные кандидаты Phpactor",
        "path": "wiki/Overview.md"
      }
    ]
  }
}
