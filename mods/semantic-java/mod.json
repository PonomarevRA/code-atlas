{
  "apiVersion": 1,
  "id": "semantic-java",
  "name": "Java semantic analysis",
  "version": "1.0.0",
  "description": "Optional installed JDT-LS candidate bindings with static source-only Eclipse context; no Maven/Gradle/builds.",
  "autoActivate": {
    "extensions": [
      ".java"
    ],
    "manifestNames": []
  },
  "analysis": {
    "apiVersion": 1,
    "semanticProviders": [
      {
        "id": "java",
        "language": "java",
        "strategy": "jdt-local-v1",
        "capabilities": [
          "definition",
          "calls"
        ]
      }
    ]
  },
  "wiki": {
    "section": "Agents-and-MCP",
    "pages": [
      {
        "id": "overview",
        "title": "Java: кандидаты JDT-LS",
        "path": "wiki/Overview.md"
      }
    ]
  }
}
