{
  "apiVersion": 1,
  "id": "language-swift",
  "name": "swift project structure",
  "version": "1.0.0",
  "description": "Declarative build-marker discovery. Logical folders are navigation areas, not claimed build modules.",
  "analysis": {
    "apiVersion": 1,
    "projectRules": [
      {
        "id": "swift-projects",
        "language": "swift",
        "extensions": [
          ".swift"
        ],
        "manifestNames": [
          "Package.swift"
        ],
        "manifestSuffixes": [],
        "sourceRootMarkers": [
          "Sources",
          "Tests"
        ],
        "logicalFolders": false
      }
    ]
  },
  "wiki": {
    "section": "Explore-Code",
    "pages": [
      {
        "id": "overview",
        "title": "Swift: структура проекта",
        "path": "wiki/Overview.md"
      }
    ]
  }
}
